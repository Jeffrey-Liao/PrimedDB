#pragma once
#include <unordered_map>
#include "Singleton.h"
#include "User.h"
#include "Transection.h"

namespace liao::Compiler
{
	union Token
	{
		std::string str;
        int num;
        char ch;
        bool boolean;
		double decimal;
		Token() = default;
	};
	class Result
	{
	public:
		Result() = default;
	};
	class Compiler: public Singleton<Compiler>
	{
		INVITESINGLETON;
	private:
		// Individual statement parsers
		static PrimedDB::Transection parseSelect(const std::string& sql);
		static PrimedDB::Transection parseInsert(const std::string& sql);
		static PrimedDB::Transection parseDelete(const std::string& sql);

		// Helper methods
		static std::vector<std::string> tokenize(const std::string& sql);
		static std::string extractTableName(const std::string& sql);
		static std::vector<std::string> extractColumns(const std::string& sql);
		static std::vector<std::string> extractValues(const std::string& sql);
	public:
		std::future<std::string> compile(PrimedDB::UserPtr,std::string&);

	};
}
